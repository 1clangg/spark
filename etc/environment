

# MESA CORE
MESA_GLTHREAD=true
mesa_glthread=true
MESA_SHADER_CACHE_DISABLE=0
MESA_SHADER_CACHE_MAX_SIZE=1G

#DISPLAY 
vblank_mode=0
LIBGL_DRI3_DISABLE=0
LIBGL_DRI3_ENABLE=1

# VULKAN 
DXVK_ASYNC=1
DXVK_STATE_CACHE=1
VKD3D_CONFIG=dxr11,dxr
VKD3D_FEATURE_LEVEL=12_1
WINE_FULLSCREEN_FSR=1
STAGING_SHARED_MEMORY=1
STAGING_WRITECOPY=1

# SHADER CACHE (persistent, not /tmp)
__GL_SHADER_DISK_CACHE=1
__GL_SHADER_DISK_CACHE_SKIP_CLEANUP=1
__GL_SHADER_DISK_CACHE_PATH=/var/cache/spark-shaders
MESA_GLSL_CACHE_DIR=/var/cache/spark-shaders
DXVK_STATE_CACHE_PATH=/var/cache/spark-shaders
VKD3D_SHADER_CACHE_PATH=/var/cache/spark-shaders

# QT/LXQT
QT_QPA_PLATFORMTHEME=lxqt
QT_AUTO_SCREEN_SCALE_FACTOR=1
QT_ENABLE_HIGHDPI_SCALING=1

# CURSOR (fix later)
XCURSOR_THEME=breeze_cursors
XCURSOR_SIZE=24

# LEGACY GTK THEME
GTK_THEME=Breeze
ICON_THEME=breeze-dark


