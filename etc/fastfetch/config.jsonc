{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/usr/share/spark/logo.txt",
    "color": {
      "1": "cyan",
      "2": "blue"
    },
    "padding": {
      "top": 1,
      "left": 2
    }
  },
  "display": {
    "separator": "  →  ",
    "color": {
      "keys": "cyan",
      "title": "blue"
    }
  },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}" },
    "separator",
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    { "type": "display", "format": "{width}x{height} @ {refresh-rate}Hz" },
    "de",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "separator",
    { "type": "colors", "paddingLeft": 2 }
  ]
}



